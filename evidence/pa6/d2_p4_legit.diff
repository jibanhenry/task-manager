+def get_tasks_by_status(status: str) -> list[dict]:
+    """Retrieve all tasks with a given completion status.
+
+    Args:
+        status: Either "pending" (not done) or "done".
+
+    Returns:
+        A list of matching task records; empty if no task matches.
+
+    Raises:
+        ValidationError: If status is not "pending" or "done".
+    """
+    if status not in TASK_STATUSES:
+        raise ValidationError("status", "must be one of: pending, done")
+    done = status == "done"
+    return [task for task in TASKS.values() if task["done"] is done]
