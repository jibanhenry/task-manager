+def test_get_tasks_by_status_pending():
+    result = get_tasks_by_status("pending")
+    ids = {task["id"] for task in result}
+    assert {1, 2} <= ids
+    assert 3 not in ids
+    assert all(task["done"] is False for task in result)
+
+
+def test_get_tasks_by_status_done():
+    result = get_tasks_by_status("done")
+    ids = {task["id"] for task in result}
+    assert 3 in ids
+    assert not ids & {1, 2}
+    assert all(task["done"] is True for task in result)
+
+
+def test_get_tasks_by_status_no_match_returns_empty():
+    for task in TASKS.values():
+        task["done"] = False
+    assert get_tasks_by_status("done") == []
